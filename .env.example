# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Required for composition; never commit real keys
VERA_MODEL=claude-sonnet-5            # Model ID (defaults to claude-sonnet-5)
VERA_GEMINI_API_KEY=                  # Optional: enables Gemini copy-polish on /v1/tick; leave blank to skip

# ── Storage ───────────────────────────────────────────────────────────────────
VERA_DB_PATH=./vera.db                # SQLite path (set to :memory: for ephemeral tests)

# ── Team metadata (returned from GET /v1/metadata) ────────────────────────────
VERA_TEAM_NAME=Team Vera
VERA_TEAM_MEMBERS=["Alice","Bob"]
VERA_CONTACT_EMAIL=team@example.com
VERA_VERSION=1.0.0

# ── Service ───────────────────────────────────────────────────────────────────
VERA_LOG_LEVEL=INFO
VERA_LLM_TIMEOUT_SECONDS=25          # Stay under the 30s judge budget
